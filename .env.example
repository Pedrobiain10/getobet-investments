# Copia este fichero como .env y rellena tus valores. .env NO se sube a git.

# Clave de https://the-odds-api.com (plan gratuito: 500 créditos/mes)
ODDS_API_KEY=

# Regiones de casas de apuestas: eu, uk, us, au (separadas por coma; cada una suma coste)
ODDS_API_REGIONS=eu

# Ruta de la base de datos SQLite (opcional)
# GETOBET_DB=data/getobet.db
